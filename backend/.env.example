# ==============================================================================
# WhatsappChatBot - Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı kopyalayarak '.env' adında yeni bir dosya oluşturun:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS: cp .env.example .env

# --- UYGULAMA YAPILANDIRMASI ---
APP_ENV=development
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- GÜVENLİK & JWT ---
# JWT Token üretimi için güçlü ve gizli bir rastgele metin girin:
SECRET_KEY=super_secret_jwt_key_degistirin_2026

# --- VERİTABANI BAĞLANTISI (DATABASE_URL) ---
# Seçenek 1: Sıfır Kurulum / Hızlı Test İçin SQLite (Varsayılan):
DATABASE_URL=sqlite:///./muhendislik_bot.db

# Seçenek 2: PostgreSQL (Üretim ortamı / Büyük veriler için):
# DATABASE_URL=postgresql://kullanici_adi:sifre@localhost:5432/muhendislik_bot

# --- GOOGLE GEMINI YAPAY ZEKA ---
# Google AI Studio üzerinden ücretsiz API anahtarınızı alın:
# https://aistudio.google.com/
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE

# Opsiyonel: OpenAI kullanmak isterseniz
OPENAI_API_KEY=

# --- META WHATSAPP CLOUD API ENTEGRASYONU ---
# Meta for Developers portalından alacağınız değerler:
# https://developers.facebook.com/

# 1. Webhook Doğrulama Belirteci (İstediğiniz güvenli bir kelime belirleyin ve Meta paneline aynısını girin):
META_WA_VERIFY_TOKEN=whatsapp_bot_verify_token_2026

# 2. Meta WhatsApp Kalıcı Erişim Token'ı (System User Access Token):
META_WA_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN

# 3. WhatsApp Test veya Canlı Telefon Numarası Kimliği (Phone Number ID):
META_WA_PHONE_ID=YOUR_META_PHONE_NUMBER_ID

# 4. Meta Uygulama Bilgileri (Gelişmiş panel senkronizasyonu için opsiyonel):
META_APP_ID=
META_APP_SECRET=

# 5. Otomatik Webhook URL'si (Admin panelinden Cloudflare tüneli başlatıldığında otomatik doldurulabilir):
META_WA_WEBHOOK_URL=
